# Server configuration — copy to .env and fill in real values.
NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string (or local mongod)
MONGO_URI=mongodb://127.0.0.1:27017/examinpocket

# Auth — use a long random string (64+ chars) in production
JWT_SECRET=replace-this-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Frontend origin allowed by CORS (not needed when serving the built client)
CLIENT_ORIGIN=http://localhost:5173

# Gemini AI — server-only secret, never exposed to the browser
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
AI_WINDOW_MINUTES=10
AI_MAX_REQUESTS=20

# Admin account created by `npm run create-admin`
ADMIN_NAME=Kaleem R Joyo
ADMIN_EMAIL=admin@examinpocket.local
ADMIN_PASSWORD=ChangeMe123!
